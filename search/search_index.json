{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u81ea\u5df1\u7d39\u4ecb","text":""},{"location":"#_2","title":"\u6240\u5c5e","text":"<p>\u829d\u6d66\u5de5\u696d\u5927\u5b66 \u5de5\u5b66\u90e8 \u96fb\u6c17\u30ed\u30dc\u30c3\u30c8\u5de5\u5b66\u30b3\u30fc\u30b9 \u9577\u8c37\u5ddd\u30fb\u8c37\u5cf6\u7814\u7a76\u5ba4 B3 https://sites.google.com/shibaura-it.ac.jp/thase-frl</p>"},{"location":"#_3","title":"\u7814\u7a76\u5185\u5bb9","text":"<p>\u81ea\u5f8b\u79fb\u52d5\u30ed\u30dc\u30c3\u30c8\u306e\u7814\u7a76\u30fb\u958b\u767a\u3002 \u73fe\u5728\u306f\u3001\u3064\u304f\u3070\u30c1\u30e3\u30ec\u30f3\u30b82026\u306b\u5411\u3051\u305f\u30ed\u30dc\u30c3\u30c8\u306e\u958b\u767a\u3092\u3057\u3066\u3044\u308b\u3002</p> <ul> <li> <p></p> <p>\u3064\u304f\u3070\u30c1\u30e3\u30ec\u30f3\u30b82026</p> </li> <li> <p></p> <p>\u81ea\u52d5\u904b\u8ee2AI\u30c1\u30e3\u30ec\u30f3\u30b82027</p> </li> </ul>"},{"location":"achievements/","title":"\u5b9f\u7e3e","text":"<ul> <li>Autoware\u30ef\u30fc\u30af\u30b7\u30e7\u30c3\u30d72026</li> <li>\u3064\u304f\u3070\u30c1\u30e3\u30ec\u30f3\u30b82026\u306b\u53c2\u52a0\u4e88\u5b9a</li> </ul>"},{"location":"aichallenge/","title":"\u81ea\u52d5\u904b\u8ee2AI\u30c1\u30e3\u30ec\u30f3\u30b8","text":"<ul> <li>\u81ea\u52d5\u904b\u8ee2AI\u30c1\u30e3\u30ec\u30f3\u30b82027\u5927\u4f1a\u306b\u53c2\u52a0\u4e88\u5b9a</li> </ul>"},{"location":"tsukuba_2026/","title":"\u3064\u304f\u3070\u30c1\u30e3\u30ec\u30f3\u30b82026","text":"<p>\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u304b\u3089\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u307e\u3067\u4e00\u8cab\u3057\u3066\u30c1\u30fc\u30e0\u3067\u30ed\u30dc\u30c3\u30c8\u3092\u958b\u767a\u3059\u308b\u3002 \u8328\u57ce\u770c\u3064\u304f\u3070\u5e02\u5185\u3067\u3001\u81ea\u5f8b\u79fb\u52d5\u30ed\u30dc\u30c3\u30c8\u3092\u8d70\u884c\u3055\u305b\u3066\u5168\u9577\u7d042.2km\u306e\u30b3\u30fc\u30b9\u306e\u5b8c\u8d70\u3059\u308b\u3053\u3068\u304c\u76ee\u6a19\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3002</p>"},{"location":"tsukuba_2026/#1","title":"1. \u6a5f\u4f53\u8a2d\u8a08","text":"<p>CAD\u3067\u4f5c\u6210\u3057\u305f\u30a2\u30eb\u30df\u30d5\u30ec\u30fc\u30e0</p> <p></p>"},{"location":"tsukuba_2026/#2","title":"2. \u96fb\u88c5","text":"<p>\u4e3b\u8981\u306a\u69cb\u6210\u90e8\u54c1\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002</p> \u90e8\u54c1 \u30e1\u30fc\u30ab\u30fc \u578b\u756a \u30d6\u30e9\u30b7\u30ec\u30b9DC\u30e2\u30fc\u30bf\u30fc T-frog TF-M30-24-3500-G15L/R \u30e2\u30fc\u30bf\u30fc\u30c9\u30e9\u30a4\u30d0 T-frog TF-2MD3-R6 \u96fb\u6e90\u30e6\u30cb\u30c3\u30c8 T-frog TF-PW36-5/12M IMU \u30a2\u30fc\u30eb\u30c6\u30a3\u30fc USB\u51fa\u529b9\u8ef8\u30bb\u30f3\u30b5\u30fc\u30e2\u30b8\u30e5\u30fc\u30eb 2D LIDAR Hokuyo UTM-30-LX-01 3D LIDAR Velodyne 80-VLP-16-A <p>\u7c21\u5358\u306a\u30b7\u30b9\u30c6\u30e0\u5168\u4f53\u306e\u914d\u7dda\u56f3\u3092\u793a\u3057\u307e\u3059\u3002</p> <p></p> <p>LIDAR \u306e\u5f79\u5272</p> <p>3D LIDAR \u306f\u4e3b\u306bNDT\u30b9\u30ad\u30e3\u30f3\u30de\u30c3\u30c1\u30f3\u30b0\u7528\u306b\u4f7f\u7528\u3057\u3001 2D LIDAR \u306f\u969c\u5bb3\u7269\u691c\u77e5\u3092\u3059\u308b\u305f\u3081\u306b\u30ed\u30dc\u30c3\u30c8\u306e\u4e0b\u5074\u306b\u30ed\u30fc\u30eb\u89d2\u3092-180\u00b0\u3057\u3066\u53d6\u308a\u4ed8\u3051\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"tsukuba_2026/#3","title":"3. \u30bd\u30d5\u30c8\u30a6\u30a7\u30a2","text":"<p>\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u5074\u306f\u4e3b\u306b\u3001\u81ea\u5df1\u4f4d\u7f6e\u63a8\u5b9a\u30e2\u30b8\u30e5\u30fc\u30eb\u3068\u7d4c\u8def\u8a08\u753b\u30e2\u30b8\u30e5\u30fc\u30eb\u306b\u5206\u304b\u308c\u3066\u3044\u307e\u3059\u3002</p> <p>\u969c\u5bb3\u7269\u56de\u907f\u306b\u95a2\u3057\u3066\u306f\u3001\u73fe\u72b6A*\u3092\u4f7f\u3063\u3066\u3044\u308b\u305f\u3081\u4e00\u5ea6\u505c\u6b62\u3057\u3066\u304b\u3089\u5c40\u6240\u56de\u907f\u7d4c\u8def\u3092\u5f15\u304d\u76f4\u3057\u3066\u304b\u3089\u52d5\u4f5c\u3057\u307e\u3059\u3002</p> <p>\u305d\u306e\u305f\u3081\u52d5\u4f5c\u304c\u9045\u304f\u3001\u30ed\u30dc\u30c3\u30c8\u540c\u58eb\u306e\u3059\u308c\u9055\u3044\u306a\u3069\u306f\u3067\u304d\u3066\u3044\u306a\u3044\u305f\u3081\u6539\u826f\u304c\u5fc5\u8981\u3068\u8003\u3048\u3066\u3044\u307e\u3059\u3002</p> \u81ea\u5df1\u4f4d\u7f6e\u63a8\u5b9a <p>3D LIDAR \u306b\u3088\u308bNDT\u30b9\u30ad\u30e3\u30f3\u30de\u30c3\u30c1\u30f3\u30b0\u3068\u3001IMU, \u30db\u30a4\u30fc\u30eb\u30aa\u30c9\u30e1\u30c8\u30ea\u3092\u30ab\u30eb\u30de\u30f3\u30d5\u30a3\u30eb\u30bf\u3067\u878d\u5408\u3059\u308b\u3053\u3068\u3067\u81ea\u5df1\u4f4d\u7f6e\u3092\u63a8\u5b9a</p> \u7d4c\u8def\u8a08\u753b <p>\u7d4c\u8def\u8a08\u753b\u306b\u95a2\u3057\u3066\u306f\u3001\u3042\u3089\u304b\u3058\u3081\u8a2d\u5b9a\u3057\u305f waypoint \u3092\u8ffd\u5f93\u3057\u3001\u969c\u5bb3\u7269\u304c\u3042\u308c\u3070\u3001A*\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3067\u5c40\u6240\u7d4c\u8def\u8a08\u753b\u3092\u3057\u3066\u56de\u907f</p>"}]}